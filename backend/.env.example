# Voyager AI Backend Environment Variables Template

# LLM API Keys
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL="postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_REF.supabase.co:5432/postgres"
SUPABASE_URL="https://YOUR_SUPABASE_REF.supabase.co"
SUPABASE_KEY="your_supabase_anon_key_here"

# Authentication & Security
JWT_SECRET="your_secure_jwt_secret_here"

# External Integrations (Optional)
OPENWEATHER_API_KEY="your_openweather_api_key_here"
OPENTRIPMAP_API_KEY="your_opentripmap_api_key_here"
OPENROUTESERVICE_API_KEY="your_openrouteservice_api_key_here"
EXCHANGERATE_API_KEY="your_exchangerate_api_key_here"
